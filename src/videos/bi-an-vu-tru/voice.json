  "lines": [
    {
      "scene": "hook",
      "index": 0,
      "text": "Đây là ba bí ẩn lớn nhất của vũ trụ mà các nhà khoa học vẫn chưa thể giải thích.",
      "start": 0,
      "end": 3.84
    },
    {
      "scene": "reason1",
      "index": 0,
      "text": "Bí ẩn thứ nhất là vật chất tối và năng lượng tối.",
      "start": 4.54,
      "end": 7.33
    },
    {
      "scene": "reason1",
      "index": 1,
      "text": "Chúng chiếm tới 95% toàn bộ vũ trụ, nhưng con người hoàn toàn vô hình trước chúng.",
      "start": 7.73,
      "end": 12.35
    },
    {
      "scene": "reason2",
      "index": 0,
      "text": "Bí ẩn thứ hai là bên trong hố đen thực sự có gì.",
